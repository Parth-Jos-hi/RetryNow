# RetryNow environment example.
# Copy to .env and fill in. Everything works without these (template mode).

# LLM explainer provider — "openai", "groq", "auto", or "template"
EXPLAINER_PROVIDER=auto

# OpenAI / Groq-compatible key (used only for the optional LLM explanation layer)
OPENAI_API_KEY=
GROQ_API_KEY=

# Model name for explanation (provider-dependent)
EXPLAINER_MODEL=gpt-4o-mini